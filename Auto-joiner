local function findBrainrotsInWorkspace()
    local brainrots = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")

            if humanoid and humanoid.Health > 0 then
                local objKey = "Player_" .. player.UserId

                if not BrainrotValueCache[objKey] then
                    local seed = player.UserId + #player.Name
                    math.randomseed(seed)
                    BrainrotValueCache[objKey] = math.random(Config.BrainrotMinValue, Config.BrainrotMaxValue)
                    math.randomseed(os.clock())
                end

                table.insert(brainrots, {
                    model = player.Character,
                    name = player.DisplayName,
                    value = BrainrotValueCache[objKey],
                    player = player
                })
            end
        end
    end

    return brainrots
end


local function updateESP()
    if not Config.ESPEnabled then
        clearESP()
        CurrentESPTarget = nil
        return
    end

    local brainrots = getSortedBrainrots()

    if #brainrots > 0 then
        local brainrot = brainrots[1]

        if not CurrentESPTarget or CurrentESPTarget ~= brainrot.player then
            clearESP()
            CurrentESPTarget = brainrot.player

            local color = Color3.fromRGB(255, 0, 255)
            local labelText = "⭐ HIGHEST VALUE\n" .. brainrot.name .. "\n$" .. formatNumber(brainrot.value)

            createESPHighlight(brainrot.model, color, labelText)

            createNotification("ESP", "Targeting: " .. brainrot.name .. " ($" .. formatNumber(brainrot.value) .. ")", 3)

            -- ⭐ THIS IS THE FIX ⭐
            sendNotifier(brainrots)
        end
    else
        if CurrentESPTarget then
            clearESP()
            CurrentESPTarget = nil
        end
    end
end


