    local dragging = false
    local dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    header.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)
end

-- Toggle UI
local function toggleUI()
    Config.UIExpanded = not Config.UIExpanded
    local mainFrame = UIElements.MainFrame
    local circleButton = UIElements.CircleButton

    if Config.UIExpanded then
        mainFrame.Visible = true
        -- Animate expansion (Smaller size for mobile)
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        mainFrame.Size = UDim2.new(0, 0, 0, 0)
        mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        local tween = TweenService:Create(mainFrame, tweenInfo, {
            Size = UDim2.new(0, 280, 0, 340), -- Updated to match new smaller size
            Position = UDim2.new(0.5, -140, 0.5, -170)
        })
        tween:Play()
    else
        -- Animate collapse
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        local tween = TweenService:Create(mainFrame, tweenInfo, {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        })
        tween:Play()
        tween.Completed:Connect(function()
            mainFrame.Visible = false
        end)
    end
end

-- Switch Tab
local function switchTab(tabName)
    for name, tab in pairs(UIElements.Tabs) do
        if name == tabName then
            tab.BackgroundColor3 = Color3.fromRGB(255, 0, 255) -- Neon magenta for active
            tab.TextColor3 = Color3.fromRGB(0, 0, 0) -- Black text on active
            UIElements.TabContents[name].Visible = true
        else
            tab.BackgroundColor3 = Color3.fromRGB(15, 15, 15) -- Dark for inactive
            tab.TextColor3 = Color3.fromRGB(255, 0, 255) -- Neon text on inactive
            UIElements.TabContents[name].Visible = false
        end
    end
end

