-- Initialize
local function init()
    createUI()
    setupEventHandlers()
    startAutoScan()
    startESP() -- Start ESP system
    
    -- Clear hitbox data on character respawn
    LocalPlayer.CharacterAdded:Connect(function()
        OriginalHitboxSizes = {}
        if Config.HitboxRemoverEnabled then
            task.wait(1) -- Wait for character to fully load
            maintainHitboxRemoval() -- Restart maintenance for new character
            removeHitbox()
        end
    end)
    
    -- Clear ESP when tracked player leaves the server
    Players.PlayerRemoving:Connect(function(player)
        if CurrentESPTarget == player then
            clearESP()
            CurrentESPTarget = nil
            if Config.ESPEnabled then
                createNotification("ESP", "Target left server", 2)
            end
        end
    end)
    
    createNotification("Steal a Brainrot", "By Sammy - Script loaded! Click brain icon.", 4)
end

