-- ESP Functions for Brainrot Detection
local function clearESP()
    for _, espObj in pairs(ESPObjects) do
        if espObj and espObj.Parent then
            espObj:Destroy()
        end
    end
    ESPObjects = {}
end

local function createESPHighlight(model, color, text)
    if not model or not model:IsA("Model") then return end

    -- Create Highlight
    local highlight = Instance.new("Highlight")
    highlight.Name = "BrainrotESP"
    highlight.Adornee = model
    highlight.FillColor = color
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = model

    table.insert(ESPObjects, highlight)

    -- Create BillboardGui for label
    if text then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "BrainrotLabel"
        billboard.Adornee = model
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = model

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = text
        textLabel.TextColor3 = color
        textLabel.TextStrokeTransparency = 0.5
        textLabel.TextScaled = true
        textLabel.Font = Enum.Font.GothamBold
        textLabel.Parent = billboard

        table.insert(ESPObjects, billboard)
    end

    return highlight
end

local function findBrainrotsInWorkspace()
    local workspace = game:GetService("Workspace")
    local brainrots = {}

    -- Common Brainrot names in Sammy's game
    local brainrotNames = {
        "Skibidi", "Grimace", "Cameraman", "Ohio", "Rizz",
        "Sigma", "Gyatt", "Mewing", "Fanum", "Smurf",
        "Brainrot", "Sammy", "Sus", "Gyat", "Rizzler"
    }

    -- Search workspace for Brainrot models
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name and obj.Name ~= "" then
            -- Check if object name contains brainrot keywords
            for _, name in ipairs(brainrotNames) do
                if string.find(obj.Name:lower(), name:lower()) then
                    -- Try to estimate value (placeholder - real game would need actual value detection)
                    local estimatedValue = math.random(1000, 10000000)
                    table.insert(brainrots, {
                        model = obj,
                        name = obj.Name,
                        value = estimatedValue
                    })
                    break
                end
            end
        end
    end

    return brainrots
end

local function updateESP()
    if not Config.ESPEnabled then
        clearESP()
        return
    end

    clearESP()

    local brainrots = findBrainrotsInWorkspace()

    if #brainrots == 0 then
        return
    end

    -- Sort by value to find highest
    table.sort(brainrots, function(a, b) return a.value > b.value end)

    -- Highlight ONLY the highest value Brainrot
    if #brainrots > 0 then
        local brainrot = brainrots[1]
        local color = Color3.fromRGB(255, 0, 255) -- Neon purple/pink
        local labelText = "⭐ HIGHEST VALUE\n" .. brainrot.name .. "\n$" .. formatNumber(brainrot.value)
        createESPHighlight(brainrot.model, color, labelText)
    end
end

-- Start ESP loop
local function startESP()
    RunService.Heartbeat:Connect(function()
        if Config.ESPEnabled then
            -- Update ESP every 2 seconds to reduce lag
            task.spawn(function()
                updateESP()
                task.wait(2)
            end)
        end
    end)
end

