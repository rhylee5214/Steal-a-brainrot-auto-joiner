-- Hitbox Remover Functions
local function removeHitbox()
    if not LocalPlayer.Character then return end
    
    local success, err = pcall(function()
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                -- Store original size using part's full name path
                local partKey = part:GetFullName()
                -- Only store if not already stored (prevents overwriting on re-enable)
                if not OriginalHitboxSizes[partKey] then
                    OriginalHitboxSizes[partKey] = {
                        size = part.Size,
                        transparency = part.Transparency,
                        canCollide = part.CanCollide,
                        massless = part.Massless
                    }
                end
                
                -- Make parts extremely small but not zero to avoid issues
                part.Size = TARGET_HITBOX_SIZE
                part.Transparency = 0.9
                part.CanCollide = false
                part.Massless = true
            end
        end
    end)
    
    if success then
        createNotification("Hitbox Remover", "Hitbox removed - character is now unhittable", 3)
    else
        createNotification("Error", "Failed to remove hitbox: " .. tostring(err), 3)
    end
end

local function restoreHitbox()
    if not LocalPlayer.Character then return end
    
    local success, err = pcall(function()
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                local partKey = part:GetFullName()
                local originalData = OriginalHitboxSizes[partKey]
                
                if originalData then
                    -- Restore original properties
                    part.Size = originalData.size
                    part.Transparency = originalData.transparency
                    part.CanCollide = originalData.canCollide
                    part.Massless = originalData.massless
                end
            end
        end
        
        -- Clear the storage after restoration
        OriginalHitboxSizes = {}
    end)
    
    if success then
        createNotification("Hitbox Remover", "Hitbox restored to normal", 3)
    else
        createNotification("Error", "Failed to restore hitbox: " .. tostring(err), 3)
    end
end

local function maintainHitboxRemoval()
    -- Disconnect old connection if exists
    if HitboxMaintenanceConnection then
        HitboxMaintenanceConnection:Disconnect()
        HitboxMaintenanceConnection = nil
    end
    
    local lastUpdate = 0
    HitboxMaintenanceConnection = RunService.Heartbeat:Connect(function()
        if Config.HitboxRemoverEnabled and LocalPlayer.Character then
            local currentTime = os.clock() -- Use os.clock() instead of deprecated tick()
            -- Only update based on configured interval
            if currentTime - lastUpdate >= Config.HitboxMaintenanceInterval then
                lastUpdate = currentTime
                for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        if part.Size ~= TARGET_HITBOX_SIZE then
                            part.Size = TARGET_HITBOX_SIZE
                            part.Transparency = 0.9
                            part.CanCollide = false
                            part.Massless = true
                        end
                    end
                end
            end
        end
    end)
end

-- Safe Anti-Hit (Auto-Dodge) Functions
local function isPlayerThreat(player)
    if not player or player == LocalPlayer then return false end
    if not player.Character then return false end
    
    local humanoid = player.Character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    
    -- Check if player has a tool equipped
    local tool = player.Character:FindFirstChildOfClass("Tool")
    if not tool then return false end
    
    return true
end

local function performDodge()
    if not LocalPlayer.Character then return false end
    
    local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
    local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return false end
    
    -- Check cooldown
    local currentTime = os.clock()
    if currentTime - LastDodgeTime < Config.AntiHit.Cooldown then
        return false
    end
    
    -- Find nearby threats
    local myPosition = rootPart.Position
    local nearestThreat = nil
    local nearestDistance = Config.AntiHit.Radius
    
    for _, player in pairs(Players:GetPlayers()) do
        if isPlayerThreat(player) then
            local theirRoot = player.Character:FindFirstChild("HumanoidRootPart")
            if theirRoot then
                local distance = (myPosition - theirRoot.Position).Magnitude
                if distance < nearestDistance then
                    nearestDistance = distance
                    nearestThreat = player
                end
            end
        end
    end
    
    -- If threat detected, dodge
    if nearestThreat and nearestThreat.Character then
        local theirRoot = nearestThreat.Character:FindFirstChild("HumanoidRootPart")
        if theirRoot then
            -- Calculate dodge direction (perpendicular to threat)
            local toThreat = (theirRoot.Position - myPosition).Unit
            local dodgeDirection = Vector3.new(-toThreat.Z, 0, toThreat.X) -- Perpendicular
            
            -- Add randomness if enabled
            if Config.AntiHit.Randomize then
                local randomAngle = math.random(-Config.AntiHit.RandomAngleRange, Config.AntiHit.RandomAngleRange)
                local rad = math.rad(randomAngle)
                local cos = math.cos(rad)
                local sin = math.sin(rad)
                dodgeDirection = Vector3.new(
                    dodgeDirection.X * cos - dodgeDirection.Z * sin,
                    0,
                    dodgeDirection.X * sin + dodgeDirection.Z * cos
                )
            end
            
            -- Calculate dodge target position
            local dodgeTarget = myPosition + (dodgeDirection * Config.AntiHit.Step)
            
            -- Use Humanoid:MoveTo for safe movement
            local success = pcall(function()
                humanoid:MoveTo(dodgeTarget)
            end)
            
            if success then
                LastDodgeTime = currentTime
                return true
            end
        end
    end
    
    return false
end

local function startAntiHit()
    if AntiHitConnection then
        return -- Already running
    end
    
    AntiHitConnection = RunService.Heartbeat:Connect(function()
        if Config.AntiHit.Enabled then
            performDodge()
        end
    end)
end

local function stopAntiHit()
    if AntiHitConnection then
        AntiHitConnection:Disconnect()
        AntiHitConnection = nil
    end
end

-- Notifier Functions
local function sendNotifier(brainrots)
    if not Config.Notifier.Url or Config.Notifier.Url == "" then
        return
    end
    
    if not brainrots or #brainrots == 0 then
        return
    end
    
    -- Truncate to 25 entries
    local truncatedBrainrots = {}
    for i = 1, math.min(#brainrots, 25) do
        table.insert(truncatedBrainrots, brainrots[i])
    end
    
    -- Get top brainrot for dedup key
    local topBrainrot = truncatedBrainrots[1]
    local dedupKey = game.JobId .. "_" .. topBrainrot.name .. "_" .. tostring(topBrainrot.value)
    
    -- Check 30s deduplication
    local currentTime = os.clock()
    if NotifierDedupCache[dedupKey] then
        local lastSent = NotifierDedupCache[dedupKey]
        if currentTime - lastSent < 30 then
            return -- Skip duplicate
        end
    end
    
    -- Update dedup cache
    NotifierDedupCache[dedupKey] = currentTime
    
    -- Cleanup old dedup entries (keep last 100)
    local dedupKeys = {}
    for key, _ in pairs(NotifierDedupCache) do
        table.insert(dedupKeys, key)
    end
    if #dedupKeys > 100 then
        table.sort(dedupKeys, function(a, b)
            return (NotifierDedupCache[a] or 0) < (NotifierDedupCache[b] or 0)
        end)
        for i = 1, #dedupKeys - 100 do
            NotifierDedupCache[dedupKeys[i]] = nil
        end
    end
    
    -- Prepare payload
    local payload = {
        placeId = Config.PlaceId,
        jobId = game.JobId,
        brainrots = {}
    }
    
    for _, brainrot in ipairs(truncatedBrainrots) do
        table.insert(payload.brainrots, {
            name = brainrot.name,
            value = brainrot.value
        })
    end
    
    -- Prepare headers
    local headers = {
        ["Content-Type"] = "application/json"
    }
    
    if Config.Notifier.Secret and Config.Notifier.Secret ~= "" then
        headers["x-notifier-token"] = Config.Notifier.Secret
    end
    
    -- Send request
    task.spawn(function()
        local success, response = pcall(function()
            return HttpService:RequestAsync({
                Url = Config.Notifier.Url,
                Method = "POST",
                Headers = headers,
                Body = HttpService:JSONEncode(payload)
            })
        end)
        
        if success and response and response.StatusCode == 200 then
            -- Success - optionally log
        else
            warn("Notifier request failed:", response)
        end
    end)
end

