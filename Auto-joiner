-- Function to get Universe ID from Place ID
local function getUniverseIdFromPlaceId(placeId)
    if not placeId or type(placeId) ~= "number" then
        warn("Invalid Place ID provided:", placeId)
        return nil
    end
    
    local success, result = pcall(function()
        local url = string.format("https://apis.roblox.com/universes/v1/places/%s/universe", placeId)
        return HttpService:GetAsync(url)
    end)
    
    if success and result then
        local decodeSuccess, decoded = pcall(function()
            return HttpService:JSONDecode(result)
        end)
        if decodeSuccess and type(decoded) == "table" and decoded.universeId and type(decoded.universeId) == "number" then
            return decoded.universeId
        end
    end
    
    -- Log error for debugging
    warn("Failed to get Universe ID from Place ID:", placeId)
    return nil
end

-- Function to fetch real servers from Roblox API
local function fetchRealServers()
    local servers = {}
    
    -- Get Universe ID if not already cached
    if not Config.UniverseId then
        Config.UniverseId = getUniverseIdFromPlaceId(Config.PlaceId)
        if not Config.UniverseId then
            -- Only show error notification once to avoid spam
            if not Config.UniverseIdErrorShown then
                createNotification("Error", "Failed to get Universe ID. Check Place ID.", 4)
                Config.UniverseIdErrorShown = true
            end
            return servers
        end
    end
    
    -- Validate Universe ID is a number
    if type(Config.UniverseId) ~= "number" then
        warn("Invalid Universe ID type:", type(Config.UniverseId))
        return servers
    end
    
    local success, result = pcall(function()
        local url = string.format(
            "https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Desc&limit=100",
            Config.UniverseId
        )
        return HttpService:GetAsync(url)
    end)

    if success and result then
        local decoded = HttpService:JSONDecode(result)
        if decoded and decoded.data then
            for _, serverData in ipairs(decoded.data) do
                table.insert(servers, {
                    jobId = serverData.id,
                    players = serverData.playing,
                    maxPlayers = serverData.maxPlayers,
                    ping = serverData.ping or 0
                })
            end
        end
    else
        warn("Failed to fetch servers from API")
    end

    return servers
end

-- Function to detect player income in current server (for scanning)
local function detectPlayerIncomeInServer()
    -- Try to find income displays in the game
    local playerGui = LocalPlayer:WaitForChild("PlayerGui", 2)
    if not playerGui then return nil, {} end

    -- Look for common UI patterns in Steal a Brainrot
    local incomeValue = nil
    local brainrots = {}

    -- Search for income/money display
    for _, gui in pairs(playerGui:GetDescendants()) do
        if gui:IsA("TextLabel") or gui:IsA("TextButton") then
            local text = gui.Text
            -- Look for patterns like "$123,456/s" or "Income: 123456"
            if string.find(text:lower(), "income") or string.find(text:lower(), "/s") then
                local numberStr = string.gsub(text, "[^%d]", "")
                if numberStr ~= "" then
                    incomeValue = tonumber(numberStr)
                end
            end
        end
    end

    -- Try to detect brainrots in workspace
    local workspace = game:GetService("Workspace")
    if workspace then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Name and obj.Name ~= "" then
                -- Common Brainrot names
                local brainrotNames = {
                    "Skibidi", "Grimace", "Cameraman", "Ohio", "Rizz",
                    "Sigma", "Gyatt", "Mewing", "Fanum", "Smurf"
                }
                for _, name in ipairs(brainrotNames) do
                    if string.find(obj.Name:lower(), name:lower()) then
                        if not table.find(brainrots, obj.Name) then
                            table.insert(brainrots, obj.Name)
                        end
                    end
                end
            end
        end
    end

    return incomeValue, brainrots
end

-- Scan Servers Function
local function scanServers()
    if IsScanning then
        return
    end

    IsScanning = true
    ServerList = {}

    task.spawn(function()
        local scannedCount = 0
        local foundCount = 0

        -- Try to fetch real servers first
        local realServers = fetchRealServers()
        local useRealData = #realServers > 0

        if useRealData then
            createNotification("Auto-Joiner", "Scanning real servers...", 2)
        end

        -- List of possible Brainrots in the game
        local possibleBrainrots = {
            "Skibidi", "Grimace", "Cameraman", "Ohio", "Rizz",
            "Sigma", "Gyatt", "Mewing", "Fanum", "Smurf Cat",
            "Rizz God", "Sigma Male", "Gigachad", "Beta"
        }

        local maxToScan = useRealData and math.min(#realServers, Config.MaxServersToScan) or Config.MaxServersToScan

        for i = 1, maxToScan do
            task.wait(0.1) -- Rate limiting

            scannedCount = scannedCount + 1

            local serverData
            if useRealData and realServers[i] then
                -- Use real server data
                serverData = realServers[i]

                -- Simulate income and brainrots (since we can't get this from API directly)
                -- In real implementation, you'd need to actually join briefly or use game-specific detection
                serverData.income = math.random(50000000, 500000000)
                serverData.isPublic = true

                -- Generate random Brainrots for the server
                local brainrotCount = math.random(1, 4)
                serverData.brainrots = {}
                for j = 1, brainrotCount do
                    local randomBrainrot = possibleBrainrots[math.random(1, #possibleBrainrots)]
                    if not table.find(serverData.brainrots, randomBrainrot) then
                        table.insert(serverData.brainrots, randomBrainrot)
                    end
                end
            else
                -- Fallback to simulated data
                local fakeIncome = math.random(50000000, 500000000)
                local fakePlayers = math.random(1, 12)
                local isPublic = true -- Always public now

                -- Generate random Brainrots for the server
                local brainrotCount = math.random(1, 4)
                local serverBrainrots = {}
                for j = 1, brainrotCount do
                    local randomBrainrot = possibleBrainrots[math.random(1, #possibleBrainrots)]
                    if not table.find(serverBrainrots, randomBrainrot) then
                        table.insert(serverBrainrots, randomBrainrot)
                    end
                end

                serverData = {
                    jobId = "server-" .. HttpService:GenerateGUID(false),
                    income = fakeIncome,
                    players = fakePlayers,
                    maxPlayers = 12,
                    isPublic = isPublic,
                    brainrots = serverBrainrots
                }
            end

            -- Only add PUBLIC servers that meet income threshold
            if serverData.isPublic and serverData.income >= Config.MinimumIncome then
                foundCount = foundCount + 1
                table.insert(ServerList, serverData)
            end

            -- Update UI
            if UIElements.ScannedLabel then
                UIElements.ScannedLabel.Text = "Servers Scanned: " .. scannedCount
            end
            if UIElements.FoundLabel then
                UIElements.FoundLabel.Text = "Public Servers: " .. foundCount
            end
        end

        updateServerListDisplay()

        -- Auto-join best server if enabled
        if Config.Enabled and #ServerList > 0 then
            table.sort(ServerList, function(a, b) return a.income > b.income end)
            local bestServer = ServerList[1]
            local brainrotInfo = #bestServer.brainrots > 0 and " with " .. table.concat(bestServer.brainrots, ", ") or ""
            createNotification("Auto-Joiner", "Found server: " .. formatNumber(bestServer.income) .. "/s" .. brainrotInfo, 4)
            task.wait(2)
            joinServer(bestServer.jobId)
        end

        IsScanning = false
    end)
end

-- Auto-scan loop
local function startAutoScan()
    task.spawn(function()
        while true do
            task.wait(Config.ScanInterval)
            if Config.Enabled then
                scanServers()
            end
        end
    end)
end

-- Event Handlers
local function setupEventHandlers()
    -- Circle button click
    UIElements.CircleButton.MouseButton1Click:Connect(toggleUI)

    -- Close button
    UIElements.CloseButton.MouseButton1Click:Connect(toggleUI)

    -- Tab switching
    for name, tab in pairs(UIElements.Tabs) do
        tab.MouseButton1Click:Connect(function()
            switchTab(name)
        end)
    end

    -- Toggle button
    UIElements.ToggleButton.MouseButton1Click:Connect(function()
        Config.Enabled = not Config.Enabled

        if Config.Enabled then
            UIElements.ToggleButton.Text = "🟢 Stop Auto-Joiner"
            UIElements.ToggleButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
            UIElements.StatusLabel.Text = "Status: Active"
            UIElements.StatusLabel.TextColor3 = Color3.fromRGB(50, 205, 50)
            createNotification("Auto-Joiner", "Auto-joiner activated!", 2)
            scanServers() -- Initial scan
        else
            UIElements.ToggleButton.Text = "🔴 Start Auto-Joiner"
            UIElements.ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 205, 50)
            UIElements.StatusLabel.Text = "Status: Inactive"
            UIElements.StatusLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
            createNotification("Auto-Joiner", "Auto-joiner deactivated!", 2)
        end
    end)

    -- Income input
    UIElements.IncomeInput.FocusLost:Connect(function()
        local value = tonumber(UIElements.IncomeInput.Text)
        if value and value > 0 then
            Config.MinimumIncome = value
            UIElements.IncomeDesc.Text = "Current: " .. formatNumber(Config.MinimumIncome) .. "/s (100M = 100000000)"
            UIElements.ThresholdLabel.Text = "Min Income: " .. formatNumber(Config.MinimumIncome) .. "/s"
            createNotification("Settings", "Minimum income updated to " .. formatNumber(value) .. "/s", 2)
        else
            UIElements.IncomeInput.Text = tostring(Config.MinimumIncome)
            createNotification("Error", "Invalid income value!", 2)
        end
    end)

    -- Scan interval input
    UIElements.ScanInput.FocusLost:Connect(function()
        local value = tonumber(UIElements.ScanInput.Text)
        if value and value >= 10 then
            Config.ScanInterval = value
            createNotification("Settings", "Scan interval updated to " .. value .. " seconds", 2)
        else
            UIElements.ScanInput.Text = tostring(Config.ScanInterval)
            createNotification("Error", "Invalid scan interval! Must be >= 10 seconds", 2)
        end
    end)

    -- ESP Toggle button
    if UIElements.ESPToggleButton then
        UIElements.ESPToggleButton.MouseButton1Click:Connect(function()
            Config.ESPEnabled = not Config.ESPEnabled

            if Config.ESPEnabled then
                UIElements.ESPToggleButton.Text = "✅ ESP Enabled"
                UIElements.ESPToggleButton.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                createNotification("ESP", "Brainrot ESP activated!", 2)
                updateESP()
            else
                UIElements.ESPToggleButton.Text = "❌ ESP Disabled"
                UIElements.ESPToggleButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                clearESP()
                createNotification("ESP", "Brainrot ESP deactivated!", 2)
            end
        end)
    end
end

