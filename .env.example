# Discord Webhook URLs (REQUIRED)
WEBHOOK_LOW=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID_LOW/YOUR_WEBHOOK_TOKEN_LOW
WEBHOOK_HIGH=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID_HIGH/YOUR_WEBHOOK_TOKEN_HIGH

# Optional: Secret token for authentication
# If set, Roblox requests must include header: x-notifier-token
SECRET_TOKEN=your_secret_token_here

# Server port (optional, Render sets this automatically)
PORT=3000
